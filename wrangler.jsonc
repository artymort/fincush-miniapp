{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fincush-bot",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "MINI_APP_URL": "https://artymort.github.io/fincush-miniapp/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FINCUSH_STATE",
        "class_name": "FincushState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FincushState"]
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *", "0 15 * * *"]
  }
}

