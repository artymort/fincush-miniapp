{
  "name": "fincush-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "check": "node --check app.js && node --check worker/index.js && node --check scripts/build-pages.mjs && node --check scripts/setup-telegram.mjs",
    "test": "node --test",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "bot:setup": "node scripts/setup-telegram.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
